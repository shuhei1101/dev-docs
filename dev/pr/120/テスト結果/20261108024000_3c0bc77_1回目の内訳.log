# prof.py
import os, sys, time, tempfile, cProfile, pstats, io
from pathlib import Path
from dev_docs.features.settings.query import config_path, load_terminal_config
from dev_docs.main import build_handlers
from dev_docs.features.access.types import Target
from dev_docs.features.documents.store import DocumentStore
from dev_docs.features.history.snapshot import SnapshotStore
from dev_docs.features.history.query import resolve_ref, file_dates
from dev_docs.features.documents.indexable import walk_files

terminal = load_terminal_config(config_path(os.environ))
terminal.sources[:] = [s for s in terminal.sources if getattr(s, "id", None) == "ai-monitor"]
h = build_handlers(terminal)
h.reload_sources(terminal)
source = h.registry.get("ai-monitor")
repo_root = source.repo_root or source.root
ref = source.config.default_ref
t = time.perf_counter(); commit = resolve_ref(repo_root, ref, date_base=ref).commit; print(f"resolve_ref: {time.perf_counter()-t:.2f} 秒（{commit[:7]}）")
tmp = Path(tempfile.mkdtemp(dir="/tmp/prof120"))
snap = SnapshotStore(tmp / "snapshots")
t = time.perf_counter(); out = snap.checkout(repo_root, commit); print(f"書き出し（git archive と展開）: {time.perf_counter()-t:.2f} 秒")
root = out / source.root.relative_to(repo_root)
t = time.perf_counter(); files = list(walk_files(root)); print(f"walk_files: {time.perf_counter()-t:.2f} 秒（{len(files)} ファイル）")
t = time.perf_counter(); file_dates(repo_root, commit=commit); print(f"ファイルの日時（file_dates）: {time.perf_counter()-t:.2f} 秒")
store = DocumentStore(snap)
target = Target(source, source.root, ref, None, "read", outside_scope=True, commit=commit)
pr = cProfile.Profile(); t = time.perf_counter(); pr.enable(); result = store.load(target); pr.disable()
print(f"load（1 回目・全体）: {time.perf_counter()-t:.2f} 秒（{len(result.documents)} 文書）")
s = io.StringIO(); pstats.Stats(pr, stream=s).sort_stats("cumulative").print_stats(18); print(s.getvalue())
t = time.perf_counter(); store.load(target); print(f"load（2 回目）: {time.perf_counter()-t:.2f} 秒")
