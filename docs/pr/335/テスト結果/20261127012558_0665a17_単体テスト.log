2026-11-26T16:23:02.3670411Z ^[[36;1m    idle=$((idle + 1))^[[0m
2026-11-26T16:23:02.3670641Z ^[[36;1m  else^[[0m
2026-11-26T16:23:02.3670828Z ^[[36;1m    idle=0^[[0m
2026-11-26T16:23:02.3671030Z ^[[36;1m    last=$size^[[0m
2026-11-26T16:23:02.3671235Z ^[[36;1m  fi^[[0m
2026-11-26T16:23:02.3671440Z ^[[36;1m  if [ "$idle" -gt "$limit" ]; then^[[0m
2026-11-26T16:23:02.3671714Z ^[[36;1m    kill -- "-$pid"^[[0m
2026-11-26T16:23:02.3672390Z ^[[36;1m    say "出力が ${limit} 秒変わらなかったため、テストを止めた"^[[0m
2026-11-26T16:23:02.3672668Z ^[[36;1m    exit 1^[[0m
2026-11-26T16:23:02.3672860Z ^[[36;1m  fi^[[0m
2026-11-26T16:23:02.3673037Z ^[[36;1mdone^[[0m
2026-11-26T16:23:02.3673232Z ^[[36;1mwait "$pid"^[[0m
