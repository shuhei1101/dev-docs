# 結合テスト（バック・TL-2）。回した commit: d64b073（ランナーの実行 44098786978）
# この後の 2f6e1d3 は tests/integration/server/conftest.py の変数に型の注記を足しただけで、振る舞いを変えない

$ run_url=$(gh workflow run test.yml --ref "$(git branch --show-current)" -f layer=backend-integration -f paths="tests/integration/server/test_get_status.py tests/integration/server/test_serve.py tests/integration/server/test_get_settings_sources.py tests/integration/server/test_put_settings_sources.py tests/integration/server/test_migrate.py" | grep -o 'https://[^ ]*/actions/runs/[0-9]*') && run_id=${run_url##*/} && (n=0; until gh api "repos/shuhei1101/dev-docs/actions/runs/$run_id?exclude_pull_requests=true" > /dev/null 2>&1; do n=$((n+1)); if [ $n -ge 10 ]; then echo "実行 $run_id を 10 秒参照できません" >&2; exit 1; fi; sleep 1; done) && (rc=0; gh run watch "$run_id" --exit-status > /dev/null || rc=1; gh run view "$run_id" --log; exit $rc)

