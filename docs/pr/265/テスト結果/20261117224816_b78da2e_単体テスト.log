2026-11-17T13:47:36.1976187Z ^[[36;1m  if [ -z "${dir:-}" ]; then^[[0m
2026-11-17T13:47:36.1976363Z ^[[36;1m    say "paths は結合テストの層でだけ指定できる: layer=$LAYER"^[[0m
2026-11-17T13:47:36.1976558Z ^[[36;1m    exit 1^[[0m
2026-11-17T13:47:36.1976721Z ^[[36;1m  fi^[[0m
2026-11-17T13:47:36.1976893Z ^[[36;1m  if ! printf '%s' "$PATHS" | grep -Eq '^[A-Za-z0-9_./ -]+$'; then^[[0m
2026-11-17T13:47:36.1977160Z ^[[36;1m    say "paths に許可しない文字がある（英数字・_・.・/・-・空白だけを許可する）: $PATHS"^[[0m
2026-11-17T13:47:36.1977349Z ^[[36;1m    exit 1^[[0m
2026-11-17T13:47:36.1977467Z ^[[36;1m  fi^[[0m
2026-11-17T13:47:36.1977591Z ^[[36;1m  for p in $PATHS; do^[[0m
2026-11-17T13:47:36.1977738Z ^[[36;1m    case "$p" in^[[0m
2026-11-17T13:47:36.1977899Z ^[[36;1m      *..*) say "paths の値が .. を含む: $p"; exit 1 ;;^[[0m
2026-11-17T13:47:36.1978068Z ^[[36;1m    esac^[[0m
2026-11-17T13:47:36.1978189Z ^[[36;1m    case "$p" in^[[0m
2026-11-17T13:47:36.1978323Z ^[[36;1m      "$dir"*) ;;^[[0m
2026-11-17T13:47:36.1978495Z ^[[36;1m      *) say "paths の値が層の結合テストのフォルダ（$dir）の外: $p"; exit 1 ;;^[[0m
2026-11-17T13:47:36.1978681Z ^[[36;1m    esac^[[0m
2026-11-17T13:47:36.1978832Z ^[[36;1m    if [ "$LAYER" = backend-integration ]; then^[[0m
2026-11-17T13:47:36.1979020Z ^[[36;1m      case "$p" in^[[0m
2026-11-17T13:47:36.1979338Z ^[[36;1m        tests/integration/frontend/*) say "paths の値が層の結合テストのフォルダの外（tests/integration/frontend/ は frontend-integration の層）: $p"; exit 1 ;;^[[0m
2026-11-17T13:47:36.1979652Z ^[[36;1m      esac^[[0m
2026-11-17T13:47:36.1979771Z ^[[36;1m    fi^[[0m
2026-11-17T13:47:36.1979885Z ^[[36;1m  done^[[0m
2026-11-17T13:47:36.1979994Z ^[[36;1mfi^[[0m
2026-11-17T13:47:36.1980107Z ^[[36;1mcase "$LAYER" in^[[0m
2026-11-17T13:47:36.1980282Z ^[[36;1m  backend-unit) cmd="uv run pytest tests/unit/ -v" ;;^[[0m
2026-11-17T13:47:36.1980528Z ^[[36;1m  backend-integration) cmd="uv run pytest ${PATHS:-$dir} -v" ;;^[[0m
2026-11-17T13:47:36.1980847Z ^[[36;1m  frontend-unit) cmd="npx vitest run --config frontend/vitest.config.ts --reporter=verbose" ;;^[[0m
2026-11-17T13:47:36.1981268Z ^[[36;1m  frontend-integration) cmd="npx playwright test --config tests/integration/frontend/playwright.config.ts $PATHS" ;;^[[0m
2026-11-17T13:47:36.1981581Z ^[[36;1mesac^[[0m
2026-11-17T13:47:36.1981725Z ^[[36;1m# テストを裏で起動し、出力を test.log と step の標準出力の両方に出す^[[0m
2026-11-17T13:47:36.1981954Z ^[[36;1msetsid -w bash -c "set -o pipefail; $cmd 2>&1 | tee -a test.log" &^[[0m
2026-11-17T13:47:36.1982158Z ^[[36;1mpid=$!^[[0m
2026-11-17T13:47:36.1982275Z ^[[36;1mlast=-1^[[0m
2026-11-17T13:47:36.1982390Z ^[[36;1midle=0^[[0m
2026-11-17T13:47:36.1982532Z ^[[36;1m# test.log の大きさを 1 秒ごとに確認し、無出力の時間が上限を超えたらテストを止める^[[0m
2026-11-17T13:47:36.1982721Z ^[[36;1mwhile kill -0 "$pid" 2> /dev/null; do^[[0m
2026-11-17T13:47:36.1982888Z ^[[36;1m  sleep 1^[[0m
2026-11-17T13:47:36.1983018Z ^[[36;1m  size=$(stat -c %s test.log)^[[0m
2026-11-17T13:47:36.1983176Z ^[[36;1m  if [ "$size" = "$last" ]; then^[[0m
2026-11-17T13:47:36.1983332Z ^[[36;1m    idle=$((idle + 1))^[[0m
2026-11-17T13:47:36.1983470Z ^[[36;1m  else^[[0m
2026-11-17T13:47:36.1983601Z ^[[36;1m    idle=0^[[0m
2026-11-17T13:47:36.1983745Z ^[[36;1m    last=$size^[[0m
2026-11-17T13:47:36.1983876Z ^[[36;1m  fi^[[0m
2026-11-17T13:47:36.1984006Z ^[[36;1m  if [ "$idle" -gt "$limit" ]; then^[[0m
2026-11-17T13:47:36.1984310Z ^[[36;1m    kill -- "-$pid"^[[0m
2026-11-17T13:47:36.1984590Z ^[[36;1m    say "出力が ${limit} 秒変わらなかったため、テストを止めた"^[[0m
2026-11-17T13:47:36.1984754Z ^[[36;1m    exit 1^[[0m
2026-11-17T13:47:36.1984873Z ^[[36;1m  fi^[[0m
2026-11-17T13:47:36.1984986Z ^[[36;1mdone^[[0m
2026-11-17T13:47:36.1985101Z ^[[36;1mwait "$pid"^[[0m
