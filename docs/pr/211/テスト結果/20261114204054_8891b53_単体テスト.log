                doc_json("n-0", "notes/files.yaml"),
                doc_json(
                    "n-1",
                    "notes/files.yaml",
                    metadata={"id": "n-1", "name": "N1", "aliases": ["作業場所"]},
                    body_path="notes/n-1.md",
                    body="# N1\n",
                    updated="2026-11-12T10:00:00+09:00",
