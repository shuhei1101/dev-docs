        "default": null,
        "title": "Cwd"
      },
      "session_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Session Id"
      },
      "agent_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
