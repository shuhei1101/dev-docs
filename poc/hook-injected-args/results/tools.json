{
  "probe": {
    "$defs": {
      "Condition": {
        "description": "1 つの項目を比べる条件。",
        "properties": {
          "field": {
            "description": "比べる項目の名前",
            "title": "Field",
            "type": "string"
          },
          "op": {
            "description": "比べ方",
            "enum": [
              "eq",
              "ne"
            ],
            "title": "Op",
            "type": "string"
          },
          "value": {
            "description": "比べる値",
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "field",
          "op",
          "value"
        ],
        "title": "Condition",
        "type": "object"
      },
      "Group": {
        "description": "条件と群を and / or で束ねる群。",
