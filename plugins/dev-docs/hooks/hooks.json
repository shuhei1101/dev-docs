{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "_description": "dev-docs が落ちていれば起動し、使える配信元と使い方をセッションの文脈に入れる",
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py"
            ],
            "timeout": 6
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "mcp__plugin_dev-docs_dev-docs__.*",
        "hooks": [
          {
            "_description": "文書の MCP のツールの入力に作業場所とセッションを入れる",
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_use.py"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
