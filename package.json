{
  "name": "dev-docs-screen",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit": "vitest run --config frontend/vitest.config.ts",
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "api:export": "uv run python frontend/scripts/export_openapi.py",
    "api:generate": "npm run api:export && orval --config frontend/orval.config.ts",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit -p frontend/tsconfig.json",
    "lint": "eslint frontend eslint.config.js",
    "prepare": "lefthook install",
    "storybook": "storybook dev -c frontend/.storybook -p 6006",
    "build-storybook": "storybook build -c frontend/.storybook -o tmp/storybook-static"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "6.0.2",
    "@tanstack/react-hotkeys": "0.17.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-hook-form": "7.91.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-boundaries": "7.4.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "msw": "3.0.3",
    "msw-storybook-addon": "3.0.3",
    "orval": "8.45.0",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
